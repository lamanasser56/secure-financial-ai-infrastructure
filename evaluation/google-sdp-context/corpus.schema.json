{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "context-pattern-v1"
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 87,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "language",
          "text",
          "expected_spans",
          "expected_action",
          "classification",
          "provenance"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^context-[0-9]{3}$"
          },
          "language": {
            "enum": [
              "en",
              "ar",
              "mixed"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "expected_action": {
            "enum": [
              "redact",
              "retain"
            ]
          },
          "classification": {
            "type": "string",
            "pattern": "^[a-z_]+$"
          },
          "provenance": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "expected_spans": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "start",
                "end",
                "category",
                "info_type"
              ],
              "properties": {
                "start": {
                  "type": "integer",
                  "minimum": 0
                },
                "end": {
                  "type": "integer",
                  "minimum": 1
                },
                "category": {
                  "enum": [
                    "CREDIT_CARD",
                    "EMAIL_ADDRESS",
                    "IBAN_CODE",
                    "PHONE_NUMBER",
                    "SAUDI_BANK_ACCOUNT",
                    "SAUDI_NATIONAL_ID",
                    "SAUDI_RESIDENT_ID",
                    "SAUDI_VAT_ID"
                  ]
                },
                "info_type": {
                  "enum": [
                    "EMAIL_ADDRESS",
                    "PORTFOLIO_NATIONAL_ID",
                    "PORTFOLIO_RESIDENT_ID",
                    "PORTFOLIO_IBAN_CONTEXT",
                    "PORTFOLIO_BANK_ACCOUNT",
                    "PORTFOLIO_VAT_ID",
                    "PORTFOLIO_PHONE_CONTEXT",
                    "PORTFOLIO_CARD_CONTEXT",
                    "PORTFOLIO_IBAN_STANDALONE",
                    "PORTFOLIO_PHONE_STANDALONE",
                    "PORTFOLIO_OBFUSCATED_EMAIL"
                  ]
                }
              }
            }
          }
        }
      }
    }
  }
}
