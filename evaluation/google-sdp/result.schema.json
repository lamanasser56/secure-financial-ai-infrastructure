{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sanitized synthetic Google SDP evaluation result",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_mode", "provider_operations", "cases", "aggregate", "outcome"],
  "properties": {
    "run_mode": {"enum": ["offline", "live"]},
    "provider_operations": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accounting", "inspect_attempted", "deidentify_attempted", "application_retries", "rpc_timeout_seconds"],
      "properties": {
        "accounting": {"enum": ["not_executed", "sdk_invocation_attempts", "test_double_unavailable"]},
        "inspect_attempted": {"type": ["integer", "null"], "minimum": 0, "maximum": 9},
        "deidentify_attempted": {"type": ["integer", "null"], "minimum": 0, "maximum": 9},
        "application_retries": {"const": 0},
        "rpc_timeout_seconds": {"enum": [3, 20], "description": "Current candidate: 3; historical seed evidence: 20."},
        "overall_timeout_seconds": {"const": 8}
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id", "expected_categories", "observed_categories", "status",
          "category_counts", "duration_seconds", "failure_code"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+){1,4}-[0-9]{3}$"
          },
          "expected_categories": {"$ref": "#/$defs/categories"},
          "observed_categories": {"$ref": "#/$defs/categories"},
          "status": {"enum": ["pass", "fail", "inconclusive"]},
          "category_counts": {"$ref": "#/$defs/category_counts"},
          "duration_seconds": {"type": "integer", "minimum": 0},
          "failure_code": {
            "enum": [
              "none", "not_executed", "provider_failure", "malformed_result",
              "missing_expected", "unexpected_detection", "observation_only"
            ]
          }
        }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "status_counts", "category_counts"],
      "properties": {
        "status": {"enum": ["pass", "fail", "inconclusive"]},
        "status_counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pass", "fail", "inconclusive"],
          "properties": {
            "pass": {"type": "integer", "minimum": 0},
            "fail": {"type": "integer", "minimum": 0},
            "inconclusive": {"type": "integer", "minimum": 0}
          }
        },
        "category_counts": {"$ref": "#/$defs/category_counts"}
      }
    },
    "outcome": {
      "enum": [
        "PASS FOR FURTHER BOUNDED INTEGRATION",
        "FAIL AND RETAIN PRESIDIO",
        "INCONCLUSIVE — MORE EVIDENCE REQUIRED"
      ]
    }
  },
  "$defs": {
    "categories": {
      "type": "array",
      "uniqueItems": true,
      "maxItems": 3,
      "items": {"enum": ["CREDIT_CARD", "EMAIL_ADDRESS", "PHONE_NUMBER"]}
    },
    "category_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed"],
      "properties": {
        "expected": {"type": "integer", "minimum": 0},
        "observed": {"type": "integer", "minimum": 0}
      }
    }
  }
}
