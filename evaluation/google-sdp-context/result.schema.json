{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "policy_id",
    "policy_sha256",
    "mode",
    "google_quality",
    "authority_changed",
    "sdk_attempts",
    "injected_attempts",
    "required_pass",
    "required_fail",
    "observations",
    "unexecuted",
    "cases",
    "outcome"
  ],
  "properties": {
    "scope": {
      "enum": [
        "context_001_diagnostic_only",
        "context_pattern_v1_campaign"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "policy_id": {
      "const": "context-pattern-v1"
    },
    "policy_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mode": {
      "enum": [
        "offline_reference",
        "live_synthetic"
      ]
    },
    "google_quality": {
      "enum": [
        "unmeasured",
        "synthetic_policy_observations_only"
      ]
    },
    "authority_changed": {
      "const": false
    },
    "sdk_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172
    },
    "injected_attempts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 172
    },
    "required_pass": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86
    },
    "required_fail": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86
    },
    "observations": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86
    },
    "unexecuted": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86
    },
    "outcome": {
      "enum": [
        "FAIL_CLOSED",
        "SYNTHETIC_POLICY_ONLY_REVIEW_REQUIRED",
        "OFFLINE_REFERENCE_PASS_GOOGLE_UNPROVEN"
      ]
    },
    "cases": {
      "type": "array",
      "maxItems": 86,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "status",
          "tp",
          "fp",
          "fn"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "pattern": "^context-[0-9]{3}$"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "FAIL_CLOSED",
              "OBSERVATION"
            ]
          },
          "tp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "fp": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "fn": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "stage"
            ],
            "properties": {
              "code": {
                "enum": [
                  "UNKNOWN",
                  "INVALID_INPUT",
                  "CONFIGURATION_REJECTED",
                  "BUSY",
                  "BUDGET_EXHAUSTED",
                  "RPC_TIMEOUT",
                  "OVERALL_TIMEOUT",
                  "RPC_STATUS",
                  "RPC_FAILURE",
                  "MALFORMED_RESPONSE",
                  "INCOMPLETE_TRANSFORMATION",
                  "OUTPUT_MISMATCH",
                  "RESIDUAL_VALUE",
                  "OUTPUT_LIMIT"
                ]
              },
              "stage": {
                "enum": [
                  "startup",
                  "input",
                  "budget",
                  "inspect",
                  "inspect_response",
                  "deidentify",
                  "output",
                  "normalize",
                  "sequence"
                ]
              },
              "rpc_status": {
                "enum": [
                  "CANCELLED",
                  "UNKNOWN",
                  "INVALID_ARGUMENT",
                  "DEADLINE_EXCEEDED",
                  "NOT_FOUND",
                  "ALREADY_EXISTS",
                  "PERMISSION_DENIED",
                  "UNAUTHENTICATED",
                  "RESOURCE_EXHAUSTED",
                  "FAILED_PRECONDITION",
                  "ABORTED",
                  "OUT_OF_RANGE",
                  "UNIMPLEMENTED",
                  "INTERNAL",
                  "UNAVAILABLE",
                  "DATA_LOSS"
                ]
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "required": [
                "diagnostic"
              ]
            },
            "then": {
              "properties": {
                "status": {
                  "const": "FAIL_CLOSED"
                }
              }
            }
          }
        ]
      }
    },
    "operational_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "observation_failures": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1
    },
    "campaign_diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage"
      ],
      "properties": {
        "code": {
          "const": "OVERALL_TIMEOUT"
        },
        "stage": {
          "const": "sequence"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "scope"
        ],
        "properties": {
          "scope": {
            "const": "context_pattern_v1_campaign"
          }
        }
      },
      "then": {
        "required": [
          "operational_failures",
          "observation_failures"
        ],
        "properties": {
          "required_pass": {
            "maximum": 70
          },
          "required_fail": {
            "maximum": 70
          },
          "observations": {
            "maximum": 16
          }
        }
      },
      "else": {
        "not": {
          "anyOf": [
            {
              "required": [
                "operational_failures"
              ]
            },
            {
              "required": [
                "observation_failures"
              ]
            },
            {
              "required": [
                "campaign_diagnostic"
              ]
            }
          ]
        }
      }
    }
  ]
}
