{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "synthetic": {
      "const": true
    },
    "period": {
      "type": "string",
      "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$",
      "minLength": 7,
      "maxLength": 7
    },
    "currency": {
      "const": "SAR"
    },
    "total_minor_units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100000000
    },
    "expense_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 20
    },
    "data_available": {
      "type": "boolean"
    }
  },
  "required": [
    "source_id",
    "synthetic",
    "period",
    "currency",
    "total_minor_units",
    "expense_count",
    "data_available"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "data_available": {
            "const": false
          }
        }
      },
      "then": {
        "properties": {
          "total_minor_units": {
            "const": 0
          },
          "expense_count": {
            "const": 0
          }
        }
      },
      "else": {
        "properties": {
          "expense_count": {
            "minimum": 1
          },
          "total_minor_units": {
            "minimum": 1
          }
        }
      }
    }
  ]
}
