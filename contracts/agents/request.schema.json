{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "agent": {
      "enum": [
        "infrastructure",
        "financial"
      ]
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "period": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^20[0-9]{2}-(0[1-9]|1[0-2])$",
          "minLength": 7,
          "maxLength": 7
        },
        {
          "type": "null"
        }
      ]
    },
    "scenario_id": {
      "enum": [
        "archive-export",
        "docker-config",
        "cluster-version",
        null
      ]
    }
  },
  "required": [
    "agent",
    "message",
    "period",
    "scenario_id"
  ]
}
