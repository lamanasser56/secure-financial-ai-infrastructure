{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Registered operation arguments",
  "type": "object",
  "additionalProperties": false,
  "required": ["target_id", "evidence_id"],
  "properties": {
    "target_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,47}$"},
    "evidence_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
