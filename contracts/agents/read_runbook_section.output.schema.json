{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "source_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "synthetic": {
      "const": true
    },
    "repair": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    },
    "limitations": {
      "type": "string",
      "minLength": 1,
      "maxLength": 600
    }
  },
  "required": [
    "source_id",
    "synthetic",
    "repair",
    "limitations"
  ]
}
