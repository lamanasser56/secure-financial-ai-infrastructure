# Allowlist build context for platform/core/images/Dockerfile (app and ops targets).
**
!requirements-platform.txt
!runtime/
!runtime/**
!contracts/
!contracts/**
!demo/
!demo/**
!evaluation/
!evaluation/agent-composition/
!evaluation/agent-composition/**
!platform/
!platform/core/
!platform/core/database/
!platform/core/database/**
!platform/core/src/
!platform/core/src/**
!platform/core/ui/
!platform/core/ui/**
!platform/core/kubernetes/
!platform/core/kubernetes/**
!platform/agents/
!platform/agents/*/
# Re-exclude descendants after opening each directory; only agent.yaml is an app input.
platform/agents/*/**
!platform/agents/*/agent.yaml
!platform/clouds/
!platform/clouds/gke/
!platform/clouds/gke/kubernetes/
!platform/clouds/gke/kubernetes/gke.yaml
!platform/clouds/gke/kubernetes/generated/
!platform/clouds/gke/kubernetes/generated/**
!docs/
!docs/examples/
!docs/examples/rejected-agent/
!docs/examples/rejected-agent/agent.yaml
**/__pycache__
**/*.pyc
**/node_modules
